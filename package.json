{
  "name": "dsh-translate-pin",
  "version": "0.3.4",
  "description": "DSH 划词翻译 + 截图翻译：选中即译、框选截图后由 DeepSeek 读图翻译，译文直接替换原区域，结果可钉在桌面置顶。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "translate",
    "translation",
    "screenshot",
    "ocr",
    "划词翻译",
    "截图翻译",
    "置顶"
  ],
  "author": "zhaopw5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaopw5/dsh-translate-pin.git"
  },
  "homepage": "https://github.com/zhaopw5/dsh-translate-pin#readme",
  "bugs": {
    "url": "https://github.com/zhaopw5/dsh-translate-pin/issues"
  }
}





